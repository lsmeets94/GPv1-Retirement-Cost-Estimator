{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "manual",
      "version": "1.0.0"
    }
  },
  "parameters": {
    "staticWebAppName": {
      "type": "string",
      "defaultValue": "gpv1-retirement-estimator",
      "minLength": 1,
      "maxLength": 40,
      "metadata": {
        "description": "Globally unique name for the Azure Static Web App."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "allowedValues": [
        "centralus",
        "eastus2",
        "eastasia",
        "westeurope",
        "westus2"
      ],
      "metadata": {
        "description": "Azure region for the Static Web App. Choose the region closest to your users."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "Free",
      "allowedValues": [
        "Free",
        "Standard"
      ],
      "metadata": {
        "description": "Pricing tier. Free is sufficient for personal or team use. Standard adds custom authentication, private endpoints, and SLA."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('staticWebAppName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]",
        "tier": "[parameters('sku')]"
      },
      "properties": {}
    }
  ],
  "outputs": {
    "staticWebAppHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('staticWebAppName')), '2023-01-01').defaultHostname]",
      "metadata": {
        "description": "Default hostname assigned to the Static Web App."
      }
    }
  }
}
